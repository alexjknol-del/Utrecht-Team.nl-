---
import type { Activity } from '../data/site';
interface Props {
  activity: Activity;
}
const { activity } = Astro.props;
---
<a class="card activity-card" href={`/activiteiten/${activity.slug}/`}>
  <div class="activity-media">
    <img src={activity.image} alt={activity.imageAlt} loading="lazy" />
    {activity.isNew && <span class="pill pill-red activity-badge">Nieuw</span>}
  </div>
  <div class="activity-body">
    <span class="pill activity-category">{activity.category}</span>
    <h3>{activity.name}</h3>
    <p>{activity.tagline}</p>
    <p class="activity-meta">{activity.groupSize}</p>
  </div>
</a>

<style>
  .activity-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-ink);
  }
  .activity-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .activity-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .activity-card:hover .activity-media img { transform: scale(1.05); }
  .activity-badge {
    position: absolute;
    top: 12px;
    left: 12px;
  }
  .activity-body { padding: 20px; }
  .activity-category { margin-bottom: 10px; }
  .activity-body h3 { margin-bottom: 6px; font-size: 1.2rem; }
  .activity-body p { font-size: 0.94rem; color: var(--color-muted); margin-bottom: 6px; }
  .activity-meta { font-weight: 600; color: var(--color-ink-soft) !important; }
</style>
