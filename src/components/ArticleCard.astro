---
interface Props {
  slug: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  pubDate: Date;
  featured?: boolean;
}
const { slug, title, description, image, imageAlt, pubDate, featured = false } = Astro.props;
const formatted = pubDate.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<a class:list={["card article-card", { featured }]} href={`/nieuws/${slug}/`}>
  <div class="article-media">
    <img src={image} alt={imageAlt} loading="lazy" />
  </div>
  <div class="article-body">
    <p class="article-date">{formatted}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="article-link">Lees verder →</span>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-ink);
  }
  .article-card.featured { flex-direction: row; }
  .article-media { aspect-ratio: 16 / 10; overflow: hidden; }
  .featured .article-media { flex: 1 1 55%; aspect-ratio: auto; }
  .article-media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.35s ease;
  }
  .article-card:hover .article-media img { transform: scale(1.05); }
  .article-body { padding: 20px; flex: 1; display: flex; flex-direction: column; }
  .featured .article-body { padding: 32px; justify-content: center; }
  .article-date {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--color-red); margin-bottom: 8px;
  }
  .article-body h3 { margin-bottom: 8px; }
  .featured .article-body h3 { font-size: 1.7rem; }
  .article-body p { font-size: 0.95rem; color: var(--color-muted); margin-bottom: 10px; }
  .article-link { font-weight: 700; font-size: 0.92rem; color: var(--color-ink); margin-top: auto; }

  @media (max-width: 720px) {
    .article-card.featured { flex-direction: column; }
  }
</style>
